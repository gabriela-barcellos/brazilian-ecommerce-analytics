# Copie este arquivo para .env e preencha com seus dados locais.
# O .env NÃO vai para o Git (já está no .gitignore).
#
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Se a senha tiver caracteres especiais (@ : / # ? %), codifique-os:
#   @ -> %40   : -> %3A   / -> %2F   # -> %23   ? -> %3F   % -> %25
DATABASE_URL=postgresql://postgres:SUA_SENHA_AQUI@localhost:5432/brazilian_ecommerce
